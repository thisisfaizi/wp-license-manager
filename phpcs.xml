<?xml version="1.0"?>
<ruleset name="WPLM">
    <description>WordPress Coding Standards for WP License Manager</description>

    <file>.</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/docs-site/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg value="ps"/>

    <!--
        WordPress-Core   = formatting + core security rules.
        WordPress-Extra   = best-practice + security sniffs (DB, escaping, nonces).
        WordPress-Docs is intentionally NOT included: this codebase documents public
        APIs with PHPDoc but does not require a docblock on every internal member, and
        WordPress.org review does not mandate it.
    -->
    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Extra">
        <!--
            PSR-4 autoloading: source files are named after their class (ClassName.php),
            not the legacy class-name.php convention. This is standard for modern,
            Composer-autoloaded plugins.
        -->
        <exclude name="WordPress.Files.FileName"/>
    </rule>

    <!--
        Custom-table data layer (src/Repositories/*). Table identifiers are always
        interpolated from $wpdb->prefix (never user input) and every value is passed
        through $wpdb->prepare() with %d/%s placeholders. The sniffs below cannot
        statically verify dynamic table names or dynamically-assembled placeholder
        lists, so they report false positives here. The queries are verified safe.
    -->
    <rule ref="WordPress.DB.PreparedSQL.InterpolatedNotPrepared">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.DB.PreparedSQLPlaceholders">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.DB.DirectDatabaseQuery">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.DB.SlowDBQuery">
        <severity>0</severity>
    </rule>

    <!--
        Exception messages are passed to exception constructors for logging/handling,
        not echoed as HTML, so they do not require esc_html(). This sniff treats every
        throw as output; disable it to avoid false positives.
    -->
    <rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
        <severity>0</severity>
    </rule>

    <!--
        The dynamic WooCommerce product-type classes (WC_Product_Wplm_Subscription and
        its variable variant) must be declared together in this file: they extend WC
        classes that only exist when WooCommerce is loaded and are therefore not
        PSR-4 autoloadable in the WPLM namespace.
    -->
    <rule ref="Generic.Files.OneObjectStructurePerFile">
        <exclude-pattern>*/Integrations/WooCommerce/SubscriptionProductType.php</exclude-pattern>
    </rule>

    <!-- Modern PHP style choices used throughout this project. -->
    <rule ref="Generic.Arrays.DisallowShortArraySyntax">
        <severity>0</severity>
    </rule>
    <rule ref="Universal.Operators.DisallowShortTernary">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.PHP.YodaConditions">
        <severity>0</severity>
    </rule>

    <!-- wc_format_decimal() sanitizes monetary input to a clean decimal string. -->
    <rule ref="WordPress.Security.ValidatedSanitizedInput">
        <properties>
            <property name="customSanitizingFunctions" type="array">
                <element value="wc_format_decimal"/>
            </property>
        </properties>
    </rule>

    <!-- Plugin text domain. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="wp-license-manager"/>
            </property>
        </properties>
    </rule>

    <config name="minimum_supported_wp_version" value="5.8"/>
    <config name="testVersion" value="8.0-"/>
</ruleset>
